// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ===== CORE MODELS =====

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  address   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile information
  username    String?
  displayName String?
  bio         String?
  avatar      String?
  website     String?
  twitter     String?
  instagram   String?
  
  // Relationships
  createdEvents    Event[]        @relation("EventCreator")
  purchasedTickets Ticket[]       @relation("TicketOwner")
  tips             EventTip[]     @relation("Tipper")
  receivedTips     EventTip[]     @relation("TipReceiver")
  checkIns         CheckIn[]
  comments         Comment[]
  rsvps            RSVP[]
  sentInvitations  Invitation[]   @relation("InvitationSender")
  receivedInvitations Invitation[] @relation("InvitationReceiver")
  friends          Friend[]       @relation("UserFriend")
  friendOf         Friend[]       @relation("FriendOf")
  badges           Badge[]        @relation("BadgeOwner")

  @@map("users")
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model Event {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @unique // On-chain event ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Basic event information
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime?
  imageUrl    String?
  
  // Event configuration
  visibility   EventVisibility @default(PUBLIC)
  status       EventStatus     @default(DRAFT)
  maxAttendees Int?
  
  // Creator information
  creatorId String @db.ObjectId
  creator   User   @relation("EventCreator", fields: [creatorId], references: [id])
  
  // Blockchain data
  chainId       Int
  blockNumber   BigInt
  transactionHash String
  logIndex      Int
  
  // Platform economics
  platformFeePercentage Int     @default(250) // 2.5% in basis points
  referrerFeePercentage Int     @default(100) // 1% in basis points
  
  // Relationships
  ticketTiers   TicketTier[]
  tickets       Ticket[]
  tips          EventTip[]
  checkIns      CheckIn[]
  comments      Comment[]
  rsvps         RSVP[]
  invitations   Invitation[]
  badges        Badge[]

  @@map("events")
}

model TicketTier {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tierId    String   // On-chain tier ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tier information
  name        String
  description String?
  price       String  // Wei amount as string
  maxSupply   Int?
  currentSupply Int   @default(0)
  
  // Sale configuration
  saleStart   DateTime?
  saleEnd     DateTime?
  
  // Associated event
  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Relationships
  tickets Ticket[]

  @@unique([eventId, tierId])
  @@map("ticket_tiers")
}

enum TicketStatus {
  ACTIVE
  USED
  REFUNDED
  TRANSFERRED
}

model Ticket {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId  String   @unique // On-chain ticket ID (tokenId)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ticket information
  status      TicketStatus @default(ACTIVE)
  purchasePrice String     // Wei amount as string
  
  // Owner information
  ownerId String @db.ObjectId
  owner   User   @relation("TicketOwner", fields: [ownerId], references: [id])
  
  // Event and tier information
  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  tierid String @db.ObjectId
  tier   TicketTier @relation(fields: [tierid], references: [id])
  
  // Blockchain data
  chainId         Int
  blockNumber     BigInt
  transactionHash String
  logIndex        Int
  
  // Purchase details
  referrer        String? // Address of referrer
  platformFee     String  // Wei amount as string
  referrerFee     String? // Wei amount as string
  
  // Relationships
  checkIns CheckIn[]

  @@map("tickets")
}

model EventTip {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  // Tip information
  amount  String // Wei amount as string
  message String?
  
  // Tip participants
  tipperId String @db.ObjectId
  tipper   User   @relation("Tipper", fields: [tipperId], references: [id])
  
  receiverId String @db.ObjectId
  receiver   User   @relation("TipReceiver", fields: [receiverId], references: [id])
  
  // Associated event
  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Blockchain data
  chainId         Int
  blockNumber     BigInt
  transactionHash String
  logIndex        Int

  @@map("event_tips")
}

enum CheckInType {
  MANUAL
  QR_CODE
  NFC
  LOCATION
  TIME_BASED
}

model CheckIn {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  // Check-in information
  checkInType CheckInType
  timestamp   DateTime    @default(now())
  location    String?
  notes       String?
  
  // Check-in participants
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
  
  // Associated event and ticket
  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  ticketId String @db.ObjectId
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  
  // Blockchain data
  chainId         Int
  blockNumber     BigInt
  transactionHash String
  logIndex        Int

  @@unique([userId, eventId, ticketId])
  @@map("check_ins")
}

// ===== SOCIAL FEATURES =====

enum RSVPStatus {
  GOING
  MAYBE
  NOT_GOING
  PENDING
}

model RSVP {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RSVP information
  status    RSVPStatus
  notes     String?
  
  // RSVP participants
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
  
  // Associated event
  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Blockchain data (if on-chain RSVP)
  chainId         Int?
  blockNumber     BigInt?
  transactionHash String?
  logIndex        Int?

  @@unique([userId, eventId])
  @@map("rsvps")
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Comment content
  content String
  edited  Boolean @default(false)
  
  // Comment author
  authorId String @db.ObjectId
  author   User   @relation(fields: [authorId], references: [id])
  
  // Associated event
  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Threading support
  parentId String?  @db.ObjectId
  parent   Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentThread")
  
  // Blockchain data
  chainId         Int
  blockNumber     BigInt
  transactionHash String
  logIndex        Int

  @@map("comments")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model Invitation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Invitation information
  status    InvitationStatus @default(PENDING)
  message   String?
  expiresAt DateTime?
  
  // Invitation participants
  senderId String @db.ObjectId
  sender   User   @relation("InvitationSender", fields: [senderId], references: [id])
  
  receiverId String @db.ObjectId
  receiver   User   @relation("InvitationReceiver", fields: [receiverId], references: [id])
  
  // Associated event
  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Blockchain data
  chainId         Int
  blockNumber     BigInt
  transactionHash String
  logIndex        Int

  @@unique([senderId, receiverId, eventId])
  @@map("invitations")
}

model Friend {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  // Friend relationship
  userId   String @db.ObjectId
  user     User   @relation("UserFriend", fields: [userId], references: [id])
  
  friendId String @db.ObjectId
  friend   User   @relation("FriendOf", fields: [friendId], references: [id])
  
  // Blockchain data
  chainId         Int
  blockNumber     BigInt
  transactionHash String
  logIndex        Int

  @@unique([userId, friendId])
  @@map("friends")
}

// ===== ERC-6909 MULTI-TOKEN SUPPORT =====

enum BadgeType {
  ATTENDANCE
  SPEAKER
  ORGANIZER
  SPONSOR
  VIP
  EARLY_BIRD
  CUSTOM
}

model Badge {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenId   String   @unique // ERC-6909 token ID
  createdAt DateTime @default(now())

  // Badge information
  badgeType   BadgeType
  name        String
  description String?
  imageUrl    String?
  isSoulbound Boolean   @default(true) // ERC-5192 support
  
  // Badge owner
  ownerId String @db.ObjectId
  owner   User   @relation("BadgeOwner", fields: [ownerId], references: [id])
  
  // Associated event
  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Blockchain data
  chainId         Int
  blockNumber     BigInt
  transactionHash String
  logIndex        Int

  @@map("badges")
}

// ===== INDEXER STATE MANAGEMENT =====

model IndexerState {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  chainId     Int      @unique
  lastBlock   BigInt
  lastUpdate  DateTime @default(now())
  isHealthy   Boolean  @default(true)
  errorCount  Int      @default(0)
  lastError   String?
  
  @@map("indexer_state")
}

model ProcessedEvent {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  chainId         Int
  blockNumber     BigInt
  transactionHash String
  logIndex        Int
  eventName       String
  processedAt     DateTime @default(now())
  
  @@unique([chainId, transactionHash, logIndex])
  @@map("processed_events")
} 