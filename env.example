# 🔧 Enhanced Assemble Protocol Indexer Configuration

# === DATABASE CONFIGURATION ===
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/assemble-indexer"

# === ASSEMBLE CONTRACT (Same address on all networks) ===
ASSEMBLE_CONTRACT_ADDRESS="0x000000000a020d45fFc5cfcF7B28B5020ddd6a85"

# === ETHEREUM MAINNET ===
ETHEREUM_RPC_URL="https://eth-mainnet.alchemyapi.io/v2/your-api-key"
ETHEREUM_WS_URL="wss://eth-mainnet.alchemyapi.io/v2/your-api-key"
START_BLOCK_ETHEREUM="21000000"

# === SEPOLIA TESTNET ===
SEPOLIA_RPC_URL="https://eth-sepolia.alchemyapi.io/v2/your-api-key"
SEPOLIA_WS_URL="wss://eth-sepolia.alchemyapi.io/v2/your-api-key"
START_BLOCK_SEPOLIA="7000000"

# === INDEXER CONFIGURATION ===
LOG_LEVEL="info"
GRAPHQL_PORT="4000"
METRICS_PORT="9090"
ENABLE_METRICS="true"

# === PERFORMANCE TUNING ===
BLOCK_POLLING_INTERVAL="12000"
MAX_RETRIES="5"
RETRY_BASE_DELAY="1000"
RETRY_MAX_DELAY="30000"
CIRCUIT_BREAKER_THRESHOLD="5"
CIRCUIT_BREAKER_TIMEOUT="60000"

# GraphQL Server Configuration
GRAPHQL_ENDPOINT="/graphql"

# Contract Configuration
EVENT_PROCESSING_BATCH_SIZE=100

# Development Configuration
NODE_ENV="development"
DEBUG=false 