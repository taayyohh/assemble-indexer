{
  "name": "assemble-indexer",
  "version": "1.0.0",
  "description": "Protocol-agnostic blockchain indexer for Assemble Protocol events",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "demo": "tsx src/demo.ts",
    "test:infra": "tsx src/index.ts",
    "test:protocol": "tsx test-protocol-compliance.ts",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "start:prod": "pm2 start ecosystem.config.cjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "tsx tests/enhanced-protocol.test.ts",
    "test:handlers": "tsx tests/handler-integration.test.ts",
    "test:watch": "tsx --watch tests/enhanced-protocol.test.ts",
    "deploy": "chmod +x deploy.sh && ./deploy.sh",
    "deploy:prod": "pnpm build && pm2 start assemble-indexer",
    "deploy:dev": "pnpm build && pm2 start assemble-dev-mode",
    "deploy:sepolia": "pnpm build && pm2 start assemble-indexer-sepolia",
    "deploy:single": "pnpm build && pm2 start ecosystem.config.cjs --only",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:monitor": "pm2 monit",
    "pm2:restart": "pm2 restart all",
    "pm2:stop": "pm2 stop all",
    "pm2:delete": "pm2 delete all",
    "audit:handlers": "tsx audit-handlers.ts",
    "audit:functionality": "tsx detailed-functionality-audit.ts",
    "audit:abi": "tsx validate-handlers-abi.ts",
    "audit:all": "npm run audit:handlers && npm run audit:functionality && npm run audit:abi",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "test:all": "npm run test && npm run test:handlers"
  },
  "keywords": [
    "blockchain",
    "indexer",
    "ethereum",
    "prisma",
    "graphql",
    "typescript",
    "assemble-protocol"
  ],
  "author": "Imaginary Labs",
  "license": "MIT",
  "dependencies": {
    "@graphql-tools/schema": "^10.0.0",
    "@imaginarylabs/assemble": "^0.1.0",
    "@prisma/client": "^5.7.1",
    "dotenv": "^16.3.1",
    "ethers": "^6.14.3",
    "graphql": "^16.8.1",
    "graphql-relay": "^0.10.0",
    "graphql-yoga": "^5.0.0",
    "prisma": "^5.7.1",
    "viem": "^1.21.4",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/ws": "^8.5.8",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.4.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}