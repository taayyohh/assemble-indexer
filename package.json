{
  "name": "assemble-indexer",
  "version": "1.0.0",
  "description": "Advanced blockchain indexer for Assemble Protocol events",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "npx tsx src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.{ts,js,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,js,json}'",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx prisma/seed.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "blockchain",
    "indexer",
    "ethereum",
    "events",
    "web3",
    "assemble",
    "protocol"
  ],
  "author": "Assemble Protocol Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@types/node": "^22.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "viem": "^2.21.53",
    "ws": "^8.18.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "globals": "^15.13.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.17.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/assembleprotocol/assemble-indexer.git"
  },
  "bugs": {
    "url": "https://github.com/assembleprotocol/assemble-indexer/issues"
  },
  "homepage": "https://github.com/assembleprotocol/assemble-indexer#readme"
}